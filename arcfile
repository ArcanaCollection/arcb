using profiles Debug Release;
using engine file .sh bash;
using threads 12;

@profile Debug;   FLAGS   = -std=c++17 -g3 -O0 -Wall -Wextra -pedantic -DDEBUG
@profile Release; FLAGS   = -std=c++20 -DNDEBUG -Ofast -march=native -mtune=native -flto=auto -fuse-linker-plugin -fno-semantic-interposition -fno-plt -fstrict-aliasing -fomit-frame-pointer -fdata-sections -ffunction-sections
@profile Debug;   LDFLAGS = ;
@profile Release; LDFLAGS = -fuse-ld=gold -Wl,-O3 -Wl,--as-needed -Wl,--gc-sections -Wl,--icf=all -Wl,--strip-all

SRCDIR    = src
BUILDDIR  = arcbuild

TOOL      = arcb
TARGET    = arcb::BUILDDIR/arcb::TOOL

@glob
SOURCES   = arcb::SRCDIR/**/*.cpp
OBJECTS   = arcb::BUILDDIR/**/*.o

INCLUDES  = -Iinclude/common 
INCLUDES += -Iinclude/core
INCLUDES += -Iinclude/parser 
INCLUDES += -Iinclude/parser/util 
INCLUDES += -Iinclude/core/util

RM        = rm
COMPILER  = g++
ECHO      = echo
PYTHON    = python3

map SOURCES -> OBJECTS;

assert "arcb::__os__"   eq "linux"         -> Error Death;
assert "arcb::COMPILER" in "arcb::__path__" -> "arcb::COMPILER is required for this project";
assert "arcb::PYTHON"   in "arcb::__path__" -> "arcb::PYTHON is required for this project";
assert "arcb::ECHO"     in "arcb::__path__" -> "arcb::ECHO is required for this project";

###########################
# PRIVATE TASKS
###########################

@engine raw arcb::ECHO
task Error()
{
This project can only be build under linux, arcb::__os__ not admitted
}


@death
@engine raw arcb::ECHO
task Death()
{
Bye!
}


@cache track arcb::SOURCES.list()  
task MakeFolders() 
{
    cd arcb::SRCDIR
    find . -type d -exec mkdir -p "../arcb::BUILDDIR"/{} \;
}

@pub
@engine file .py arcb::PYTHON
task Message() 
{
print('+-----------------------------------------------------------------------+')
print('Executing arcb::__main__ for arcb::TOOL in arcb::__profile__ mode!')
print('+-----------------------------------------------------------------------+')
print('SYMBOLS')
print('main       : arcb::__main__')
print('root       : arcb::__root__')
print('version    : arcb::__version__')
print('codename   : arcb::__release__')
print('profile    : arcb::__profile__')
print('threads    : arcb::__threads__')
print('max_threads: arcb::__max_threads__')
print('OS         : arcb::__os__')
print('arch       : arcb::__arch__')
print('path       : arcb::__path__')
print('+-----------------------------------------------------------------------+')
print('VARIABLES')
print('BUILDDIR   : arcb::BUILDDIR')
print('SRCDIR     : arcb::SRCDIR')
print('TOOL       : arcb::TOOL')
print('TARGET     : arcb::TARGET')
print('SOURCES    : arcb::SOURCES.list()')
print('OBJECTS    : arcb::OBJECTS.list()')
print('INCLUDES   : arcb::INCLUDES.list()')
print('ECHO       : arcb::ECHO')
print('RM         : arcb::RM')
print('PYTHON     : arcb::PYTHON')
print('COMPILER   : arcb::COMPILER')
print('FLAGS      : arcb::FLAGS')
print('LDFLAGS    : arcb::LDFLAGS')
print('+-----------------------------------------------------------------------+')
print('STATISTICS')
print('# of SOURCES      : arcb::SOURCES.size()')
print('# of OBJECTS      : arcb::OBJECTS.size()')
print('# of INCLDIR      : arcb::INCLUDES.size()')
print('LDFLAGS emptiness : arcb::LDFLAGS.empty()')
print('+-----------------------------------------------------------------------+')
print()
}


@echo
@cache    track arcb::SOURCES.list()  
@requires MakeFolders
@threading
task Compile() 
{
arcb::COMPILER arcb::FLAGS arcb::INCLUDES.inline() -c arcb::SOURCES.list() -o arcb::OBJECTS.list()
}


@echo
@cache store arcb::SOURCES.list()  
task Link()
{
arcb::COMPILER arcb::LDFLAGS arcb::FLAGS arcb::OBJECTS.inline() -o arcb::TARGET
}


###########################
# PUBLIC TASKS
###########################


@pub
@then  MakeFolders
@cache untrack arcb::SOURCES.list() 
task Clean() 
{
    rm -rf arcb::BUILDDIR
}


@pub
@main
@requires Message Compile Link
task Build() {}


@pub
@requires Message Clean Build
task Rebuild() {}


@pub
@requires Clean Build
task Install()
{
    sudo cp arcb::TARGET /usr/bin/  
}


@pub
task Uninstall()
{
    sudo rm /usr/bin/arcb::TOOL   
}


